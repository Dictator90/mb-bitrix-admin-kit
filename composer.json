{
  "name": "mb4it/bitrix-admin-kit",
  "description": "Admin Kit Library for 1C-Bitrix",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "mb4it/collections": "^1.0",
    "mb4it/stringable": "^1.0",
    "mb4it/conditionable": "^1.0",
    "mb4it/filesystem": "^1.0"
  },
  "authors": [
    {
      "name": "Maxim Bezvodinskikh",
      "email": "m.bezvodinskikh@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "MB\\Bitrix\\AdminKit\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^1.10",
    "friendsofphp/php-cs-fixer": "^3.0",
    "mb4it/bitrix-core-test": "^0.1"
  },
  "autoload-dev": {
    "psr-4": {
      "MB\\Bitrix\\AdminKit\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --testsuite Unit && phpunit --testsuite Integration --bootstrap tests/bootstrap.php",
    "test:unit": "phpunit --testsuite Unit",
    "test:integration": "phpunit --testsuite Integration --bootstrap tests/bootstrap.php",
    "analyse": "phpstan analyse --configuration=phpstan.neon --memory-limit=512M",
    "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
    "cs-check": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff"
  }
}
