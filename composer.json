{
  "name": "mb4it/bitrix-admin-kit",
  "description": "Admin Kit Library for 1C-Bitrix",
  "type": "library",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "mb4it/collections": "^1.0",
    "mb4it/stringable": "^1.0",
    "mb4it/conditionable": "^1.0"
  },
  "authors": [
    {
      "name": "Maxim Bezvodinskikh",
      "email": "m.bezvodinskikh@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "MB\\Bitrix\\AdminKit\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^1.10",
    "friendsofphp/php-cs-fixer": "^3.0"
  },
  "autoload-dev": {
    "psr-4": {
      "MB\\Bitrix\\AdminKit\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse src tests",
    "cs-fix": "php-cs-fixer fix"
  }
}
